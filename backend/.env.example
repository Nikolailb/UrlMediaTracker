DATABASE_URL=sqlite:///./tracker.db
DEFAULT_CHECK_INTERVAL_MIN=60
PROBE_REQUEST_TIMEOUT=10.0
PROBE_DELAY_SECONDS=0.5
# Coarse step for the two-phase chapter probe (step by N until miss, then refine by 1)
PROBE_COARSE_STEP=5
# Safety cap: max number of coarse steps per check (total look-ahead = PROBE_COARSE_STEP * MAX_COARSE_STEPS)
MAX_COARSE_STEPS=100
# Hard wall-clock timeout for a single probe run in seconds (kills a stuck climb)
MAX_PROBE_DURATION_SECONDS=60.0
